# Skopiuj do .env (plik .env jest w .gitignore - NIE trafia do repo).
#
# API NFZ "Terminy Leczenia" nie wymaga rejestracji ani klucza (stan: recon 2026-08-10),
# ale regulamin wymaga identyfikacji klienta w nagłówku User-Agent. Ustaw kontakt,
# żeby NFZ mógł się z nami skontaktować zamiast blokować ruch.
NFZ_USER_AGENT="ileczekam.pl/0.1 (+https://ileczekam.pl; kontakt: kontakt@ileczekam.pl)"

# Opcjonalnie: nadpisanie bazowego URL API (np. na potrzeby testów).
# NFZ_API_BASE_URL=https://apinfz.nfz.gov.pl/app-itl-api-pcus/
